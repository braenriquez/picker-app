# Copy to .env and fill in. Never commit .env.

# Where the SQLite file lives. Keep it on a LUKS-encrypted volume for at-rest protection.
DB_PATH=./data/inventory.db

# Bind address/port. Tailscale serve/funnel proxy to this loopback port.
HOST=127.0.0.1
PORT=8080

# CORS allowlist for the PWA origin(s) calling /api/*. Comma-separated, or '*'/empty to reflect
# any origin (auth is Bearer-token, not cookies, so reflect is acceptable). In prod set this to
# your GitHub Pages origin, e.g. https://<user>.github.io
CORS_ORIGIN=*

# Secret used to sign short-lived API JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=changeme-generate-a-long-random-value

# JWT lifetime for the app's API token (seconds). 3600 = 1 hour.
JWT_TTL=3600

# Shared secret for the email-ingest webhook HMAC. Generate like JWT_SECRET.
WEBHOOK_SECRET=changeme-generate-a-long-random-value

# Comma-separated allowlist of sender addresses permitted to inject inventory by email.
WEBHOOK_FROM_ALLOWLIST=inventory@yourdomain.com

# --- Admin gating ---
# Tailscale Serve injects this header for tailnet requests; Funnel (public) requests never have it.
# In production keep this as-is. For LOCAL dev without Tailscale, set ADMIN_DEV_BYPASS=1 to skip the check.
ADMIN_HEADER=tailscale-user-login
ADMIN_DEV_BYPASS=0

# --- Layer 3: optional app-level envelope encryption (defense in depth) ---
# 0 = transport encryption only (Funnel TLS). 1 = also encrypt the inventory blob with a
# content key wrapped per connection key, so the plaintext never leaves the DB.
ENABLE_ENVELOPE=0
